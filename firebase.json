{
  "hosting": {
    "target": "app",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "src/server/**"
    ],
    "rewrites": [
      {
        "source": "/supervisores",
        "destination": "/src/client/supervisores.html"
      },
      {
        "source": "**",
        "destination": "/src/client/index.html"
      }
    ]
  }
}